{
  "manifest_version": 3,
  "name": "AITools",
  "version": "6.0.0",
  "description": "Un espace de travail privé pour capturer, planifier, rechercher et organiser le web.",
  "permissions": ["storage", "tabs", "tabGroups", "alarms", "scripting", "activeTab", "notifications", "identity"],
  "host_permissions": ["https://yvtukwaepqqsvacbbyou.supabase.co/*"],
  "action": {
    "default_title": "AITools",
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-pomodoro": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Démarrer ou suspendre le Pomodoro AITools"
    },
    "save-to-reading-list": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Ajouter la page active à la liste de lecture AITools"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
